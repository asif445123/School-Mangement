MONGODB_URI=mongodb://localhost:27017/school-management
# Generate each secret separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Required only for saving WhatsApp access tokens. Keep stable: changing it makes saved tokens unreadable.
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
# Optional server-side Meta Graph API version (default v23.0).
WHATSAPP_GRAPH_VERSION=v23.0
# Set your deployed HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
